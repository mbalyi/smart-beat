{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Smart Beat",
  "version": "../package.json",
  "identifier": "com.mbalyi.smartbeat",
  "build": {
    "beforeDevCommand": "pnpm soundfonts:fetch && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm soundfonts:fetch && pnpm licenses:generate && pnpm build && node scripts/stage-plugin-helper.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart Beat",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "media-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "media-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBOEE3QUFDMjMxNTZCNTMKUldSVGF4VWpySHFLV3NtR09IbDExWkdyUWRENU5CbnpIbXlOZnp1R2hWSnhCdWlFUGlmYVM4TEkK",
      "endpoints": ["https://github.com/mbalyi/smart-beat/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/smart-beat-plugin-helper"],
    "fileAssociations": [
      {
        "ext": ["gp3", "gp4", "gp5", "gpx", "gp"],
        "name": "Guitar Pro tab",
        "description": "Guitar Pro tab",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/x-guitar-pro",
        "exportedType": {
          "identifier": "com.mbalyi.smartbeat.guitarpro",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["mid", "midi"],
        "name": "MIDI file",
        "description": "MIDI file",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "audio/midi",
        "exportedType": {
          "identifier": "com.mbalyi.smartbeat.midi",
          "conformsTo": ["public.midi-audio"]
        }
      },
      {
        "ext": ["musicxml", "mxl"],
        "name": "MusicXML score",
        "description": "MusicXML score",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/vnd.recordare.musicxml",
        "exportedType": {
          "identifier": "com.mbalyi.smartbeat.musicxml",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["mscx", "mscz"],
        "name": "MuseScore score",
        "description": "MuseScore score",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/x-musescore",
        "exportedType": {
          "identifier": "com.mbalyi.smartbeat.musescore",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["atex"],
        "name": "alphaTex tab",
        "description": "alphaTex tab",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/x-alphatex",
        "exportedType": {
          "identifier": "com.mbalyi.smartbeat.alphatex",
          "conformsTo": ["public.text"]
        }
      },
      {
        "ext": ["capx"],
        "name": "Capella score",
        "description": "Capella score",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/x-capella",
        "exportedType": {
          "identifier": "com.mbalyi.smartbeat.capella",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "category": "Music",
    "publisher": "Mark Balyi",
    "homepage": "https://github.com/mbalyi/smart-beat",
    "copyright": "Copyright © 2026 @mbalyi (github.com/mbalyi). Source code licensed under PolyForm Noncommercial 1.0.0.",
    "shortDescription": "Practice, create and break the era",
    "longDescription": "Smart Beat is a free tablature editor for musicians and learners on macOS, Windows and Linux. Record your ideas, get the band together with in-person and online jamming, and practice with optional, self-hosted AI tools too.",
    "licenseFile": "../EULA.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "1.1.0"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "sound"
      }
    }
  }
}
