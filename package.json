{
  "name": "smart-beat",
  "private": true,
  "version": "1.1.0",
  "description": "Smart Beat is a free tablature editor for musicians and learners on macOS, Windows and Linux. Record your ideas, get the band together with in-person and online jamming, and practice with optional, self-hosted AI tools too.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Mark Balyi <smart-beat@outlook.com>",
  "homepage": "https://github.com/mbalyi/smart-beat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbalyi/smart-beat.git"
  },
  "bugs": "https://github.com/mbalyi/smart-beat/issues",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "E2E_GROUP=smoke playwright test",
    "test:e2e:additional": "E2E_GROUP=additional playwright test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "licenses:check": "node scripts/check-licenses.mjs && cargo deny --manifest-path src-tauri/Cargo.toml check licenses bans sources advisories",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "version:check": "node scripts/version.mjs check",
    "release:patch": "node scripts/version.mjs patch",
    "release:minor": "node scripts/version.mjs minor",
    "release:major": "node scripts/version.mjs major",
    "soundfonts:fetch": "node scripts/fetch-soundfonts.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm docs:check && pnpm version:check && pnpm test && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "drums:report": "node scripts/drum-support.mjs && prettier --write docs/drum-midi-support.md",
    "ranges:report": "node scripts/sound-ranges.mjs && prettier --write src/lib/audio/sound-ranges.json"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-joyride": "3.2.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@coderline/alphatab-vite": "1.8.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
