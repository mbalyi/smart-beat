# Copy to .env (git-ignored). The local build reads it (src-tauri/build.rs); real environment
# variables win over this file. Client IDs are for direct cloud access (#187); see the cloud
# setup guide. A provider with no ID shows "Not available in this build".
# In a git worktree the build also reads the .env of the main checkout, so one file there is
# enough (order: environment variables, the worktree's .env, the main checkout's .env). Rebuild
# after editing. Where the values are: docs/release.md (Cloud sign-in keys).
#   Google:    Cloud console > APIs & Services > Credentials > OAuth client "Desktop app"
#   Microsoft: Entra admin center > App registrations > the app > Application (client) ID
#   Dropbox:   App Console > the app > Settings > App key
SMARTBEAT_GOOGLE_CLIENT_ID=
SMARTBEAT_GOOGLE_CLIENT_SECRET=
SMARTBEAT_MICROSOFT_CLIENT_ID=
SMARTBEAT_DROPBOX_CLIENT_ID=
