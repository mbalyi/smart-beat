{
  "version": 1,
  "presets": [
    {
      "id": "nu-metal-crunch",
      "name": "Nu-metal crunch",
      "target": "guitar",
      "genres": ["nu-metal"],
      "description": "Scooped Rectifier-style crunch with plenty of low end, for drop C and B riffs.",
      "chain": [
        {
          "type": "gate",
          "enabled": true,
          "thresholdDb": -55,
          "rangeDb": -80,
          "attackMs": 0.5,
          "holdMs": 15,
          "releaseMs": 50
        },
        {
          "type": "drive",
          "enabled": true,
          "mode": "distortion",
          "drive": 0.7,
          "tone": 0.4,
          "levelDb": -3,
          "tightHz": 80
        },
        {
          "type": "cab",
          "enabled": true,
          "ir": "builtin:4x12-vintage"
        },
        {
          "type": "eq",
          "enabled": true,
          "bands": [
            {
              "kind": "highPass",
              "freq": 70,
              "q": 0.707,
              "gainDb": 0
            },
            {
              "kind": "peak",
              "freq": 120,
              "q": 1,
              "gainDb": 3
            },
            {
              "kind": "peak",
              "freq": 500,
              "q": 0.9,
              "gainDb": -5
            },
            {
              "kind": "peak",
              "freq": 2000,
              "q": 1.2,
              "gainDb": -2
            },
            {
              "kind": "peak",
              "freq": 4500,
              "q": 1.2,
              "gainDb": 3
            },
            {
              "kind": "lowPass",
              "freq": 9000,
              "q": 0.707,
              "gainDb": 0
            }
          ]
        }
      ]
    },
