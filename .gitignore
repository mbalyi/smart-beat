# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
src-tauri/gen/schemas/

# Generated at build time (see scripts/generate-licenses.mjs)
public/third-party-licenses.txt

# Copied by the alphaTab Vite plugin (music font, Sonivox SoundFont) and
# downloaded by scripts/fetch-soundfonts.mjs (FluidR3 SoundFont)
public/font/
public/soundfont/

# Test output
coverage/
playwright-report/
test-results/
blob-report/

# Logs and local env
*.log
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local Claude Code state (worktrees, preview config, personal settings)
.claude/worktrees/
.claude/launch.json
.claude/settings.local.json

# Paid extension kit (AI features, extra functions): lives here for now, never committed.
# It will move to its own private repository.
/extensions/

# Signing material and credentials: never commit (CI reads them from GitHub secrets)
*.key
*.key.pub
*.p8
*.p12
*.pfx
*.pem
*.cer
*.mobileprovision
